# Groq chatbot
GROQ_API_KEY=coloque_sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b
# Preços em USD por 1 milhão de tokens, usados no custo da observabilidade de IA (E7).
# Valores de referência (públicos); conferir na tabela de preços da Groq. Opcionais.
GROQ_PRICE_INPUT_PER_1M_USD=0.15
GROQ_PRICE_OUTPUT_PER_1M_USD=0.75

# Mercado Pago Checkout Pro
# Use credenciais de TESTE enquanto estiver desenvolvendo.
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# URLs usadas pelo Mercado Pago para retorno e webhook.
# Em produção, troque para o domínio público do seu frontend/backend.
FRONTEND_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Admin (Área do Funcionário - Fase 2)
# Use senhas fortes e diferentes por perfil em produção.
ADMIN_PASSWORD=troque_essa_senha
ADMIN_TOKEN_SECRET=troque_esse_segredo_por_uma_string_grande

# Login por conta (JWT, POST /api/token), usado pela aplicação Angular.
# Obrigatório: sem esta chave o login por conta não é emitido (sem fallback fixo).
JWT_SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# RBAC (Fase 2 - Gestão de Acessos e Governança). Opcionais: se não
# configuradas, apenas o perfil Gestão (ADMIN_PASSWORD) existe, como na Fase 1.
# FINANCIAL_PASSWORD dá acesso ao Dashboard Financeiro além dos demais.
# SUPPORT_PASSWORD só visualiza dados acadêmicos (Alunos/Cursos/IA).
FINANCIAL_PASSWORD=troque_essa_senha_financeiro
SUPPORT_PASSWORD=troque_essa_senha_suporte
