# Groq chatbot
GROQ_API_KEY=coloque_sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b
# Preços em USD por 1 milhão de tokens, usados no custo da observabilidade de IA (E7).
# Valores de referência (públicos); conferir na tabela de preços da Groq. Opcionais.
GROQ_PRICE_INPUT_PER_1M_USD=0.15
GROQ_PRICE_OUTPUT_PER_1M_USD=0.75

# Mercado Pago Checkout Pro
# Use credenciais de TESTE enquanto estiver desenvolvendo.
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Segredo de assinatura do webhook (E9): painel do Mercado Pago > Webhooks > Chave secreta.
# Sem ele o webhook responde 503 e nada é processado (fail closed). Nunca versione o valor real.
MERCADO_PAGO_WEBHOOK_SECRET=coloque_o_segredo_do_webhook_aqui

# URLs usadas pelo Mercado Pago para retorno e webhook.
# Em produção, troque para o domínio público do seu frontend/backend.
FRONTEND_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Admin (Área do Funcionário - Fase 2)
# Use senhas fortes e diferentes por perfil em produção.
ADMIN_PASSWORD=troque_essa_senha
ADMIN_TOKEN_SECRET=troque_esse_segredo_por_uma_string_grande

# Login por conta (JWT, POST /api/token), usado pela aplicação Angular.
# Obrigatório: sem esta chave o login por conta não é emitido (sem fallback fixo).
JWT_SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# RBAC (Fase 2 - Gestão de Acessos e Governança). Opcionais: se não
# configuradas, apenas o perfil Gestão (ADMIN_PASSWORD) existe, como na Fase 1.
# FINANCIAL_PASSWORD dá acesso ao Dashboard Financeiro além dos demais.
# SUPPORT_PASSWORD só visualiza dados acadêmicos (Alunos/Cursos/IA).
FINANCIAL_PASSWORD=troque_essa_senha_financeiro
SUPPORT_PASSWORD=troque_essa_senha_suporte

# CORS (E9): origens permitidas, separadas por vírgula, sem "*". Opcional; quando ausente valem
# FRONTEND_BASE_URL, http://localhost:4200, http://127.0.0.1:4200 e http://127.0.0.1:8000.
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com,https://www.exemplo.com

# Pagamento simulado (H3/O0). SOMENTE para demonstração local; NUNCA em produção.
# O mock só vale com PAYMENTS_MOCK ligado (1/true/yes/on) E APP_ENV=development. Em qualquer outro
# ambiente (APP_ENV ausente, production, staging...) a variável é ignorada e o Mercado Pago real é usado.
# Com o mock efetivo, a compra é aprovada sem pagamento, aparece no /health (payments_mock: true)
# e fica registrada na auditoria como payment.mock_approved.
# APP_ENV=development
# PAYMENTS_MOCK=1

# E-mail real por SMTP (U6, D88). Opcional: sem SMTP_HOST, os links vão só para o PASSWORD_LINK_OUTBOX/log.
# Gmail: ative a verificação em duas etapas e gere uma "senha de app" em https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu.email@gmail.com
# SMTP_PASSWORD=senha_de_app_de_16_letras
# SMTP_FROM=Global Training <seu.email@gmail.com>
